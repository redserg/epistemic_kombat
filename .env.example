# Select one of the preconfigured modes:
# - cloud -> Nebius Token Factory with gpt-oss-20b
# - local -> Ollama with gpt-oss:20b
LLM_MODE=cloud

# Global overrides if you want to point the project at a custom OpenAI-compatible endpoint.
# LLM_API_KEY=
# LLM_BASE_URL=

# Cloud mode defaults.
TOKEN_FACTORY_API_KEY=
TOKEN_FACTORY_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# Local mode defaults.
OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Backward-compatible legacy names still work for cloud mode:
# NEBIUS_API_KEY=
# NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/
